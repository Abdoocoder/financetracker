# Fajrak Flutter — environment template
#
# Copy this file to `.env` (gitignored):
#   cp .env.example .env
#
# The Makefile reads `.env` and forwards each value with `--dart-define`.
# If `.env` is absent it falls back to `.env.local`, so either name works.
# `make setup` creates `.env` from this file only when neither exists.
#
# Do NOT run `flutter build appbundle --release` directly: bypassing the
# Makefile ships a build with empty credentials (see CHANGELOG [3.42.2+57]).

# ── Supabase (required) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Firebase (required for Android push + analytics) ─
# Values come from android/app/google-services.json. These are public
# identifiers (shipped inside the app), not secrets.
# The Makefile matches these names without an anchor, so the FLUTTER_* aliases
# used by older env files (FLUTTER_FIREBASE_API_KEY, …) also resolve.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Sentry crash reporting (optional) ───────────────
# Project Settings → Client Keys (DSN). Without it, Sentry init is skipped
# entirely — the app still runs, just with no crash reporting.
SENTRY_DSN=

# ── Not forwarded by the Makefile (documented for accuracy) ─
# BYOK_KEK_ID / BYOK_PUBLIC_KEY are read by lib/services/byok/envelope.dart via
# --dart-define. The Makefile does not pass them, so the app resolves the same
# values from GET https://fajrak.com/api/byok/config (public, no session).
# BYOK_KEK_ID=
# BYOK_PUBLIC_KEY=
#
# API_BASE_URL is a plain Makefile variable (`API_BASE_URL ?= https://fajrak.com`),
# not a .env key. Override it from the shell instead:
#   API_BASE_URL=http://localhost:33964 make run-web-with-proxy
#
# TWELVE_DATA_KEY and PROXY_BASE_URL are inert today: they are only read through
# `flutter_dotenv`, but `.env` is not a declared asset and dotenv.load() is never
# called. Stock prices therefore call Twelve Data without a key; BYOK falls back
# to https://fajrak.com. Move them to --dart-define before relying on them.
# TWELVE_DATA_KEY=
# PROXY_BASE_URL=
