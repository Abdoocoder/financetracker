# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Firebase Configuration
# Firebase Configuration (optional - for push notifications)
# These values can be found in your google-services.json or GoogleService-Info.plist
FLUTTER_FIREBASE_API_KEY=your-api-key
FLUTTER_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FLUTTER_FIREBASE_APP_ID=your-app-id

# Market Data
TWELVE_DATA_KEY=your-twelve-data-api-key-here

# BYOK LLM Proxy (Feature A)
# PROXY_BASE_URL is the web origin that hosts /api/byok/proxy.
PROXY_BASE_URL=https://fajrak.com
# BYOK_KEK_ID and BYOK_PUBLIC_KEY (SPKI PEM) must equal the web app's
# NEXT_PUBLIC_BYOK_KEK_ID / NEXT_PUBLIC_BYOK_PUBLIC_KEY values.
BYOK_KEK_ID=your-kek-id-here
BYOK_PUBLIC_KEY=your-spki-public-key-pem-here