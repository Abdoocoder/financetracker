# =================================================
# MARKET DATA & APIs
# =================================================
TWELVE_DATA_KEY=
NEXT_PUBLIC_EXCHANGE_RATE_KEY=

# =================================================
# CRON JOB SECURITY
# =================================================
CRON_SECRET=

# =================================================
# BYOK LLM PROXY (Feature A) — asymmetric RSA envelope (AD-4)
# =================================================
# Server-held RSA-OAEP keypair (SHA-256). Only the PUBLIC key is distributed to
# clients (safe in the browser bundle); the PRIVATE key is env/secret-manager
# ONLY — NEVER in the DB or on disk. Used to wrap an ephemeral AES-GCM envelope
# key per request so the proxy can decrypt the user's provider key in memory and
# destroy it after use.
#   Private (pkcs8 PEM, server-only):
BYOK_PRIVATE_KEY=
#   Public (spki PEM, safe to ship to the browser):
NEXT_PUBLIC_BYOK_PUBLIC_KEY=
# Key-id tag placed on every envelope; enables additive rotation (old keypair
# kept until all fragments are re-wrapped).
NEXT_PUBLIC_BYOK_KEK_ID=
# Optional: set to "true" to enable verbose per-request logging (forwarded body,
# key-destroy timing). Off by default — production traces stay minimal.
BYOK_PROXY_DEBUG=

# =================================================
# MONITORING (Sentry)
# =================================================
# IMPORTANT: The DSN project ID MUST match the org/project in next.config.mjs!
# Get your DSN from Sentry: Settings → Projects → <project> → Client Keys (DSN)
# Format: https://<public_key>@o<org_id>.ingest.<region>.sentry.io/<project_id>
#
# If DSN project ID doesn't match next.config.mjs org/project, you'll get 403 errors.
# Either:
#   1. Set correct DSN in .env.local (recommended)
#   2. Or set SENTRY_ORG and SENTRY_PROJECT env vars to match your DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Optional: Override org/project from next.config.mjs if they differ from defaults
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_TUNNEL_ROUTE=/monitoring

# =================================================
# NEXT.JS SERVER ACTIONS
# =================================================
# Encrypts the Server Action IDs embedded in client bundles.
#
# Without a fixed key, Next.js derives a random key per build, so every
# deployment changes the action IDs. Any browser still running the previous
# build then POSTs a stale action ID and gets "Failed to find Server Action"
# (deployment skew) instead of a working form.
#
# Required in production AND preview. Must be a base64-encoded 32-byte key:
# Next.js calls `atob(key)` and imports the result as an AES-GCM key, so an
# invalid length crashes the build. Generate one with: `openssl rand -base64 32`
#
# The placeholder below is a valid-shaped key for local wiring only — it is
# public in this repo, so NEVER deploy with it.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# =================================================
# VERCEL SYSTEM (Generated automatically by Vercel)
# =================================================
VERCEL_OIDC_TOKEN=
