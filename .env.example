# =================================================
# APP CONFIG
# =================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fajrak FinanceTracker
TIMEZONE_OFFSET_HOURS=3

# =================================================
# SUPABASE CONFIG
# =================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =================================================
# E2E TESTING (Playwright)
# =================================================
# Dedicated test account used by e2e/setup/global-setup.ts to build the
# authenticated storageState (e2e/.auth/user.json). Create this as a normal
# user in the backend the tests run against — never use a real user's account.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# =================================================
# FIREBASE CONFIG (For Android Push Notifications)
# =================================================
# Client (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=

# Admin (Backend)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =================================================
# PUSH NOTIFICATIONS (VAPID / Web Push)
# =================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# =================================================
# MARKET DATA & APIs
# =================================================
TWELVE_DATA_KEY=
NEXT_PUBLIC_EXCHANGE_RATE_KEY=

# =================================================
# CRON JOB SECURITY
# =================================================
CRON_SECRET=

# =================================================
# BYOK LLM PROXY (Feature A) — asymmetric RSA envelope (AD-4)
# =================================================
# Server-held RSA-OAEP keypair (SHA-256). Only the PUBLIC key is distributed to
# clients (safe in the browser bundle); the PRIVATE key is env/secret-manager
# ONLY — NEVER in the DB or on disk. Used to wrap an ephemeral AES-GCM envelope
# key per request so the proxy can decrypt the user's provider key in memory and
# destroy it after use.
#   Private (pkcs8 PEM, server-only):
BYOK_PRIVATE_KEY=
#   Public (spki PEM, safe to ship to the browser):
NEXT_PUBLIC_BYOK_PUBLIC_KEY=
# Key-id tag placed on every envelope; enables additive rotation (old keypair
# kept until all fragments are re-wrapped).
NEXT_PUBLIC_BYOK_KEK_ID=

# =================================================
# MONITORING (Sentry)
# =================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# =================================================
# VERCEL SYSTEM (Generated automatically by Vercel)
# =================================================
VERCEL_OIDC_TOKEN=
