# =================================================
# APP CONFIG
# =================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
TIMEZONE_OFFSET_HOURS=3
# Unreferenced by source code today (checked 2026-11-01: no read outside this
# template). Kept so older deployments that set it keep working.
NEXT_PUBLIC_APP_NAME=Fajrak FinanceTracker

# =================================================
# SUPABASE CONFIG
# =================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =================================================
# CLERK AUTH (Webhook for profile auto-creation)
# =================================================
# Clerk webhook secret for verifying incoming webhook payloads.
# Get this from Clerk Dashboard → Webhooks → Signing Secret (starts with whsec_).
# Used by /api/webhooks/clerk to verify Clerk is the sender.
CLERK_WEBHOOK_SECRET=
# Clerk Backend API key — ONLY used by scripts/import-to-clerk.ts (one-off user
# import). The running app never reads it, so it belongs in your shell, not in
# the deployed environment.
# CLERK_SECRET_KEY=

# =================================================
# NEON — RESTORED STANDBY COPY (diagnostics only)
# =================================================
# Read-only verification target for /api/health/db.
#
# Neon currently holds a restored copy of the Supabase database but has NO
# Supabase Auth (GoTrue), NO PostgREST and NO Realtime server, so it must never
# serve user-facing queries.
#
# Use the POOLED connection string (host contains "-pooler").
#
# ⚠️  This client authenticates as the table owner, which BYPASSES RLS.
#     Never use it for per-user data — see lib/db/neon.ts.
#
# Leave empty to disable the probe (it then returns 503 instead of crashing).
DATABASE_URL=

# =================================================
# SUPABASE DB VALIDATION — no secrets required
# =================================================
# .github/workflows/supabase-validate.yml runs DRY-RUN validation only
# (structural guard + `supabase db lint` on an isolated local stack).
# It never connects to the live project, so no ACCESS_TOKEN / PROJECT_ID
# secrets are needed. Project ref linked locally: ujwcvtpwsaidljecqbaa

# =================================================
# E2E TESTING (Playwright)
# =================================================
# Dedicated test account used by e2e/setup/global-setup.ts to build the
# authenticated storageState (e2e/.auth/user.json). Create this as a normal
# user in the backend the tests run against — never use a real user's account.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Optional E2E knobs. All are skipped when unset.
# Base URL of a local Ollama server; enables e2e/byok-chat-flow.spec.ts.
OLLAMA_URL=
# PATs used by e2e/mcp-auth-tool-audit.spec.ts (full-access and read-only).
E2E_MCP_PAT=
E2E_MCP_READONLY_PAT=
# Override the Chromium binary when Playwright's bundled one is unavailable.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# =================================================
# FIREBASE CONFIG (Push notifications)
# =================================================
# Client (browser bundle — these are public identifiers, not secrets).
# NOTE: authDomain and storageBucket are hardcoded in lib/firebase.ts and
# public/firebase-messaging-sw.js, so they are intentionally not env-driven.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Read by the Flutter Makefile (mobile/fajrak_flutter/.env), not by the web app.
# Public identifiers — same values as the NEXT_PUBLIC_* pair above.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Legacy: the web app has no firebase-admin client today (push delivery runs in
# the Supabase Edge Function `push-notification`). Leave empty unless a future
# server path starts importing firebase-admin.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Service-account JSON for the `push-notification` Edge Function. This is a
# Supabase Edge Function secret (`supabase secrets set`), NOT a Next.js env var;
# it is listed here so the full credential set lives in one place.
FIREBASE_SERVICE_ACCOUNT_KEY=

# =================================================
# PUSH NOTIFICATIONS (VAPID / Web Push)
# =================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# =================================================
# MARKET DATA & APIs
# =================================================
TWELVE_DATA_KEY=
# Unreferenced by source code today (checked 2026-11-01); exchange rates come
# from the public Yahoo endpoint. Kept so older setups do not break.
NEXT_PUBLIC_EXCHANGE_RATE_KEY=

# =================================================
# CRON JOB SECURITY
# =================================================
CRON_SECRET=

# =================================================
# BYOK LLM PROXY (Feature A) — asymmetric RSA envelope (AD-4)
# =================================================
# Server-held RSA-OAEP keypair (SHA-256). Only the PUBLIC key is distributed to
# clients (safe in the browser bundle); the PRIVATE key is env/secret-manager
# ONLY — NEVER in the DB or on disk. Used to wrap an ephemeral AES-GCM envelope
# key per request so the proxy can decrypt the user's provider key in memory and
# destroy it after use.
#   Private (pkcs8 PEM, server-only):
BYOK_PRIVATE_KEY=
#   Public (spki PEM, safe to ship to the browser):
NEXT_PUBLIC_BYOK_PUBLIC_KEY=
# Key-id tag placed on every envelope; enables additive rotation (old keypair
# kept until all fragments are re-wrapped). The NEXT_PUBLIC_ copy is what the
# browser sends; the server-side BYOK_KEK_ID must be the same string or the
# proxy rejects the envelope.
NEXT_PUBLIC_BYOK_KEK_ID=
BYOK_KEK_ID=
# Previous keypairs still accepted during rotation, as a JSON array read by
# lib/byok/key-rotation.ts (default: '[]'). Example shape (values are real keys,
# so keep this out of git): [{"keyId":"kek-fajrak-v0","privateKey":"-----BEGIN PRIVATE KEY-----\\n..."}]
BYOK_PREVIOUS_KEYS=
# Optional: set to "true" to enable verbose per-request logging (forwarded body,
# key-destroy timing). Off by default — production traces stay minimal.
BYOK_PROXY_DEBUG=

# =================================================
# MONITORING (Sentry)
# =================================================
# IMPORTANT: The DSN project ID MUST match the org/project in next.config.mjs!
# Get your DSN from Sentry: Settings → Projects → <project> → Client Keys (DSN)
# Format: https://<public_key>@o<org_id>.ingest.<region>.sentry.io/<project_id>
#
# If DSN project ID doesn't match next.config.mjs org/project, you'll get 403 errors.
# Either:
#   1. Set correct DSN in .env.local (recommended)
#   2. Or set SENTRY_ORG and SENTRY_PROJECT env vars to match your DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Server-only alias of the same DSN. sentry.server.config.ts / sentry.edge.config.ts
# read `SENTRY_DSN || NEXT_PUBLIC_SENTRY_DSN`, so setting just the NEXT_PUBLIC_ one
# is enough; this exists for deployments that keep the DSN server-side only.
SENTRY_DSN=
# Optional: Override org/project from next.config.mjs if they differ from defaults.
# Both must match the DSN above or source-map upload fails with 403.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TUNNEL_ROUTE=

# =================================================
# NEXT.JS SERVER ACTIONS
# =================================================
# Encrypts the Server Action IDs embedded in client bundles.
#
# Without a fixed key, Next.js derives a random key per build, so every
# deployment changes the action IDs. Any browser still running the previous
# build then POSTs a stale action ID and gets "Failed to find Server Action"
# (deployment skew) instead of a working form.
#
# Required in production AND preview. Must be a base64-encoded 32-byte key:
# Next.js calls `atob(key)` and imports the result as an AES-GCM key, so an
# invalid length crashes the build. Generate one with: `openssl rand -base64 32`
#
# The placeholder below is a valid-shaped key for local wiring only — it is
# public in this repo, so NEVER deploy with it.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# =================================================
# OBSERVABILITY (OpenTelemetry — optional)
# =================================================
# OTLP/HTTP collector endpoint. Defaults to http://localhost:4318 when unset;
# leave empty unless you run a collector. See observability/otel/index.ts.
OTEL_EXPORTER_OTLP_ENDPOINT=

# =================================================
# VERCEL SYSTEM (Generated automatically by Vercel)
# =================================================
# Injected by Vercel at build/runtime. Do not set this locally or in CI.
VERCEL_OIDC_TOKEN=
