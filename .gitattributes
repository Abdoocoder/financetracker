# Standardize line endings to LF for all text files
* text=auto eol=lf

# Explicitly mark certain files as text and ensure LF
*.dart text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.kts text eol=lf

# Ensure shell scripts have LF
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.pdf binary
