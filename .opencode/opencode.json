{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dart": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "/home/ubuntu/.local/bin/uvx",
          "mcp-server-git",
          "--repository",
          "/home/ubuntu/financetracker"
        ]
      }
    }
  }
}
