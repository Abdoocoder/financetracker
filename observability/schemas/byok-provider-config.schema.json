{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fajrak BYOK Provider Configuration",
  "description": "Single-source provider config for BYOK (Feature A). Generates TypeScript (web) and Dart (Flutter) via codegen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Config schema version (semver)"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "baseUrl", "defaultModel", "auth", "authHeaderName"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique provider identifier (kebab-case)"
          },
          "name": {
            "type": "string",
            "description": "Display name for UI"
          },
          "kind": {
            "type": "string",
            "enum": ["proxy", "clientDirect"],
            "description": "Routing: proxy (via Fajrak BYOK proxy) or clientDirect (direct to LLM)"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Upstream API endpoint. For clientDirect (Ollama), use localhost/LAN. For proxy, points to provider API."
          },
          "defaultModel": {
            "type": "string",
            "description": "Default model ID for this provider"
          },
          "availableModels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of available models for UI selector"
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["bearer", "x-api-key", "x-goog-api-key", "none"],
                "description": "Authentication style for provider"
              }
            }
          },
          "authHeaderName": {
            "type": "string",
            "description": "Header name to strip before injecting key (e.g., 'authorization', 'x-api-key')"
          },
          "defaultHeaders": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Extra headers to always include (e.g., anthropic-version)"
          }
        }
      }
    }
  }
}